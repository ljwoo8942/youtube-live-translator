{
  "name": "youtube-live-translator-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --test tests/layout-audio-contract.test.mjs",
    "preview": "vite preview",
    "stt:setup": "uv python install 3.11 && uv venv --allow-existing --python 3.11 .venv-stt && uv pip install --python .venv-stt -r local_stt/requirements.txt",
    "stt:start": "uv run --no-project --python .venv-stt python -m uvicorn local_stt.app:app --host 127.0.0.1 --port 8765",
    "stt:daemon": "uv run --no-project --python .venv-stt python local_stt/start_server.py",
    "stt:dev": "npm run stt:start",
    "stt:health": "uv run --no-project --python .venv-stt python local_stt/health_check.py",
    "stt:test": "uv run --no-project --python .venv-stt python -m unittest local_stt.test_app"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
